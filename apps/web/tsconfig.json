{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    // Dos raices, igual que la plantilla: sus archivos importan tanto
    // `@/components/ui/...` como `@/partials/...`, y los partials viven bajo
    // `app/components/`. Sin la segunda raiz habria que reescribir 124 archivos
    // y perderiamos poder diffearlos contra una version nueva de Metronic.
    "paths": { "@/*": ["./*", "./app/components/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

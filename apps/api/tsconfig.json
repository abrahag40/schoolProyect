{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // NestJS se apoya en metadatos de decoradores para inyectar dependencias.
    // Sin emitDecoratorMetadata el contenedor no sabe que construir y la app
    // falla en arranque, no en compilacion: por eso queda fijado aqui y
    // documentado (§ del registro de decisiones).
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Los decoradores de Nest usan patrones que TS marca como no usados.
    "noUnusedParameters": false
  },
  // Cubre TODO el paquete: pruebas y archivos de configuracion incluidos.
  // No emite (de eso se encarga tsconfig.build.json). Asi el editor y el
  // analisis estatico con tipos resuelven cada archivo sin proyectos de
  // respaldo — el papercut que aparecia cada vez que se agregaba una prueba.
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts"]
}

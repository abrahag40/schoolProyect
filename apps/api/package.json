{
  "name": "@azahar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de Azahar. Proceso de larga vida (no serverless): los crons de cobranza y los webhooks de pasarela lo exigen (ADR-003).",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "start": "node dist/main.js",
    "lint": "echo 'eslint pendiente de configurar en S1'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azahar/db": "workspace:*",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/platform-express": "11.2.1",
    "@node-rs/argon2": "^2.0.2",
    "jose": "^5.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

{
  // Proyecto de RESPALDO, solo para el análisis estático. No compila nada.
  //
  // Por qué existe: las pruebas y los archivos de configuración quedan fuera
  // del tsconfig de cada paquete a propósito —`apps/api` compila solo `src` y
  // `packages/db` excluye `test`, o el build emitiría las pruebas dentro de
  // dist—. Sin este respaldo, ESLint no puede resolver sus tipos y las reglas
  // que más valen (promesas sin await) quedarían apagadas justo en los
  // archivos que verifican el comportamiento.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Las pruebas del API levantan la aplicación Nest completa: sin esto, el
    // parser no entiende los decoradores que importan.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}

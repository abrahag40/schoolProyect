{
  "name": "@azahar/db",
  "version": "0.1.0",
  "private": true,
  "description": "Acceso a datos multi-tenant con RLS forzado (ADR-004).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "migrate:dev": "node scripts/ensure-app-role.mjs && prisma migrate dev",
    "migrate:deploy": "node scripts/ensure-app-role.mjs && prisma migrate deploy && node scripts/ensure-app-role.mjs --grants-only",
    "studio": "prisma studio",
    "test": "node scripts/ensure-app-role.mjs --grants-only && vitest run",
    "lint": "echo 'ESLint entra en S1 (deuda declarada en CHANGELOG). En S0 el analisis estatico lo cubren TypeScript strict, prettier, el gate de tokens y Semgrep en CI.'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.1.0",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "prisma": "7.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

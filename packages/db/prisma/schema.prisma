// Esquema de datos de Azahar.
//
// DOS ESQUEMAS, DOS FRONTERAS (ADR-008):
//   public     -> operacion de las escuelas. RLS forzado por tenant.
//   plataforma -> negocio de ZaharDev sobre sus clientes. Sin RLS de tenant
//                 (su dueno somos nosotros), tras un guard de plataforma.
// La unica costura entre mundos es plataforma.cliente.tenantId -> public.tenant.id,
// y es unidireccional a proposito.
//
// REGLAS BI-READY (§37, ADR-008) aplicadas en todo este archivo:
//   - Los hechos son eventos append-only, nunca filas que se editan.
//   - Todo evento lleva cuatro coordenadas: tenant, actor, cuando (timestamptz
//     con zona explicita) y tipo estable.
//   - Lo que se va a agregar o graficar es columna tipada; JSON solo para
//     carga util accesoria.
//   - El dinero es Decimal (§4). Jamas punto flotante.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "plataforma"]
}

// ===========================================================================
// PLATAFORMA — ZaharDev y sus clientes (C1 / ADR-008)
// ===========================================================================

/// Persona con acceso a la consola de plataforma. La membresia es explicita y
/// por correo: NUNCA se deduce de un rol dentro de una escuela.
/// Precedente que obliga a esta regla: en Zentor una cuenta demo compartible
/// abria la consola cross-tenant. Una cuenta demo jamas es de plataforma.
model MiembroPlataforma {
  id       String        @id @default(uuid()) @db.Uuid
  email    String        @unique
  nombre   String
  rol      RolPlataforma
  socioId  String?       @map("socio_id") @db.Uuid
  activo   Boolean       @default(true)
  creadoEn DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  socio    Socio?        @relation(fields: [socioId], references: [id])

  @@map("miembro")
  @@schema("plataforma")
}

/// Vendedor o distribuidor con cartera propia. El piso intermedio de la
/// piramide CEO -> socio -> escuela.
model Socio {
  id                 String              @id @default(uuid()) @db.Uuid
  nombre             String
  email              String              @unique
  /// Porcentaje de comision sobre la suscripcion. Decimal, no float: es dinero.
  porcentajeComision Decimal             @map("porcentaje_comision") @db.Decimal(5, 2)
  activo             Boolean             @default(true)
  creadoEn           DateTime            @default(now()) @map("creado_en") @db.Timestamptz(6)
  clientes           Cliente[]
  miembros           MiembroPlataforma[]

  @@map("socio")
  @@schema("plataforma")
}

/// La escuela vista como CLIENTE de ZaharDev (no como espacio de datos).
/// Aqui vive lo que la escuela no debe ver ni administrar: su plan, su precio
/// negociado, su estado de cuenta y de quien es la cartera.
model Cliente {
  id       String @id @default(uuid()) @db.Uuid
  /// Llave hacia el mundo operativo. Es la unica costura entre esquemas.
  tenantId String @unique @map("tenant_id") @db.Uuid

  estado         EstadoCliente @default(CORTESIA)
  plan           String        @default("base")
  /// Precio mensual negociado. Puede diferir del de lista: el CEO cierra tratos.
  precioMensual  Decimal       @map("precio_mensual") @db.Decimal(10, 2)
  moneda         String        @default("MXN")
  alumnosMaximos Int           @default(200) @map("alumnos_maximos")
  /// Modulos add-on habilitados (AZ-A*). Afecta lo que la escuela ve.
  modulosActivos String[]      @default([]) @map("modulos_activos")
  cortesiaHasta  DateTime?     @map("cortesia_hasta") @db.Timestamptz(6)
  socioId        String?       @map("socio_id") @db.Uuid
  altaEn         DateTime      @default(now()) @map("alta_en") @db.Timestamptz(6)
  socio          Socio?        @relation(fields: [socioId], references: [id])

  @@index([estado])
  @@index([socioId])
  @@map("cliente")
  @@schema("plataforma")
}

/// Bitacora de negocio de ZaharDev: altas, cambios de plan, cortesias,
/// suspensiones. Append-only — es la tabla de hechos del dashboard ejecutivo.
model EventoPlataforma {
  id         String   @id @default(uuid()) @db.Uuid
  /// Las cuatro coordenadas (§37): a que cliente, quien, cuando y que.
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorEmail String   @map("actor_email")
  tipo       String
  ocurridoEn DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(6)
  /// Detalle accesorio. Lo que se agrega o grafica vive en columnas, no aqui.
  datos      Json?
  /// Importe involucrado cuando aplica (cambio de precio, cortesia valorizada).
  montoMxn   Decimal? @map("monto_mxn") @db.Decimal(10, 2)

  @@index([tenantId, ocurridoEn])
  @@index([tipo, ocurridoEn])
  @@map("evento")
  @@schema("plataforma")
}

enum RolPlataforma {
  CEO
  SOCIO
  SOPORTE

  @@schema("plataforma")
}

enum EstadoCliente {
  CORTESIA
  ACTIVO
  SUSPENDIDO
  CANCELADO

  @@schema("plataforma")
}

// ===========================================================================
// PUBLIC — operacion de cada escuela (RLS forzado)
// ===========================================================================

/// Escuela u organizacion. Raiz del aislamiento: nada existe fuera de un Tenant.
model Tenant {
  id       String   @id @default(uuid()) @db.Uuid
  nombre   String
  slug     String   @unique
  vertical Vertical @default(COLEGIO)
  activo   Boolean  @default(true)
  creadoEn DateTime @default(now()) @db.Timestamptz(6)

  sedes            Sede[]
  usuarios         Usuario[]
  periodos         Periodo[]
  cohortes         Cohorte[]
  alumnos          Alumno[]
  tutores          Tutor[]
  avisosPrivacidad AvisoPrivacidad[]
  configuracion    ConfiguracionEscuela?
  conceptoCargos   ConceptoCargo[]

  @@map("tenant")
  @@schema("public")
}

/// Plantel o campus.
model Sede {
  id       String   @id @default(uuid()) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  nombre   String
  /// Clave del Centro de Trabajo (SEP). Solo aplica a incorporadas.
  cct      String?
  /// Acuerdo RVOE. Dato maestro del complemento IEDU (A1), capturado desde S0
  /// aunque la facturacion llegue en R2: recapturar despues seria un retrabajo
  /// por cada escuela (principio 4, captura unica).
  rvoe     String?
  activa   Boolean  @default(true)
  creadaEn DateTime @default(now()) @db.Timestamptz(6)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cohortes Cohorte[]
  roles    UsuarioRol[]

  @@index([tenantId])
  @@map("sede")
  @@schema("public")
}

/// Persona con acceso al sistema (staff, y en R3 tambien tutores).
model Usuario {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  email        String
  passwordHash String   @map("password_hash")
  nombre       String
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now()) @db.Timestamptz(6)

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles          UsuarioRol[]
  tutor          Tutor?
  dispositivos   DispositivoPush[]
  asignaciones   AsignacionDocente[]
  notificaciones Notificacion[]

  /// Unico DENTRO de la escuela: la misma persona puede ser tutora en un
  /// colegio y entrenadora en una academia.
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("usuario")
  @@schema("public")
}

/// Rol de una persona, opcionalmente acotado a una sede.
///
/// Tabla y no columna (AZ-M1.3): en una escuela chica el administrador tambien
/// da clases y cobra. Modelarlo como un solo rol obliga a mentir o a crear dos
/// cuentas — deseo documentado en el corpus de resenas del sector.
model UsuarioRol {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  rol       Rol
  /// Rol acotado a una sede (p. ej. coordinadora del Campus Norte). Null = toda
  /// la escuela.
  sedeId    String?  @map("sede_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sede    Sede?   @relation(fields: [sedeId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rol, sedeId])
  @@index([tenantId])
  @@map("usuario_rol")
  @@schema("public")
}

/// Ventana temporal de operacion. Su TIPO es lo que hace multi-vertical al
/// producto: un colegio piensa en ciclos, una academia en temporadas, un
/// instituto de idiomas en cohortes continuas.
model Periodo {
  id       String      @id @default(uuid()) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  nombre   String
  tipo     TipoPeriodo
  inicio   DateTime    @db.Date
  fin      DateTime?   @db.Date
  activo   Boolean     @default(true)
  creadoEn DateTime    @default(now()) @map("creado_en") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cohortes Cohorte[]

  @@index([tenantId, activo])
  @@map("periodo")
  @@schema("public")
}

/// EL ATOMO MULTI-VERTICAL (§9). Un grado de primaria, una categoria sub-12,
/// un nivel B1 de ingles o un taller de robotica son la misma cosa: un grupo de
/// alumnos que comparte periodo, sede y responsable.
///
/// Modelar esto como "grado escolar" y adaptarlo despues obligaria a reescribir
/// el nucleo — la limitacion estructural que hoy tienen los competidores.
model Cohorte {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  periodoId String      @map("periodo_id") @db.Uuid
  sedeId    String      @map("sede_id") @db.Uuid
  nombre    String
  tipo      TipoCohorte
  /// Para ordenar en la interfaz (1o, 2o, 3o...). No es identidad.
  orden     Int         @default(0)
  activa    Boolean     @default(true)
  creadaEn  DateTime    @default(now()) @map("creada_en") @db.Timestamptz(6)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodo       Periodo             @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  sede          Sede                @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  inscripciones Inscripcion[]
  asignaciones  AsignacionDocente[]
  asistencias   Asistencia[]
  conceptos     ConceptoCargo[]

  @@index([tenantId, periodoId])
  @@map("cohorte")
  @@schema("public")
}

/// Alumno. Datos generales unicamente: lo medico y psicopedagogico es dato
/// sensible de menor y vive en el add-on A2, con consentimiento expreso previo
/// (LFPDPPP 2025). Separarlos no es burocracia: quien no contrata A2 no toca
/// ese riesgo.
model Alumno {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  nombre          String
  apellidos       String
  /// Fecha de nacimiento: fuente unica de la edad para los defaults por franja
  /// etaria (A8/A9). Ventaja estructural sobre cualquier red social: la escuela
  /// ya validó esta edad.
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  curp            String?
  /// Matricula interna de la escuela.
  matricula       String?
  activo          Boolean   @default(true)
  creadoEn        DateTime  @default(now()) @map("creado_en") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inscripciones Inscripcion[]
  tutores       TutorAlumno[]
  asistencias   Asistencia[]
  cargos        Cargo[]

  @@index([tenantId])
  @@index([tenantId, activo])
  @@map("alumno")
  @@schema("public")
}

/// Alumno inscrito en una cohorte. Es un HECHO con fecha: la matricula de un
/// periodo se reconstruye contando inscripciones, no leyendo un contador.
model Inscripcion {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  alumnoId  String            @map("alumno_id") @db.Uuid
  cohorteId String            @map("cohorte_id") @db.Uuid
  estado    EstadoInscripcion @default(ACTIVA)
  altaEn    DateTime          @default(now()) @map("alta_en") @db.Timestamptz(6)
  bajaEn    DateTime?         @map("baja_en") @db.Timestamptz(6)

  alumno  Alumno  @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  cohorte Cohorte @relation(fields: [cohorteId], references: [id], onDelete: Cascade)

  @@unique([alumnoId, cohorteId])
  @@index([tenantId, estado])
  @@map("inscripcion")
  @@schema("public")
}

/// Adulto responsable de uno o mas alumnos. Puede o no tener acceso al sistema.
model Tutor {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nombre    String
  apellidos String
  email     String?
  telefono  String?
  /// Si tiene acceso a la app. Null = registrado pero sin cuenta todavia.
  usuarioId String?  @unique @map("usuario_id") @db.Uuid
  creadoEn  DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuario         Usuario?         @relation(fields: [usuarioId], references: [id])
  alumnos         TutorAlumno[]
  consentimientos Consentimiento[]
  partesDeCargo   ParteDeCargo[]
  pagos           Pago[]

  @@index([tenantId])
  @@map("tutor")
  @@schema("public")
}

/// Vinculo tutor-alumno. Aqui vive el MULTI-PAGADOR (AZ-M2.2): dos padres
/// separados que dividen la colegiatura, o una abuela que paga y no recoge.
/// Los competidores modelan un solo "responsable de pago" y por eso sus
/// usuarios piden a gritos incluir al tercer pagador en el recibo.
model TutorAlumno {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  tutorId              String     @map("tutor_id") @db.Uuid
  alumnoId             String     @map("alumno_id") @db.Uuid
  parentesco           Parentesco @default(TUTOR)
  esPagador            Boolean    @default(false) @map("es_pagador")
  /// Reparto del cargo entre pagadores. Suma 100 entre los pagadores de un
  /// alumno; la validacion vive en el dominio (packages/core, S4).
  porcentajePago       Decimal?   @map("porcentaje_pago") @db.Decimal(5, 2)
  esContactoEmergencia Boolean    @default(false) @map("es_contacto_emergencia")
  puedeRecoger         Boolean    @default(false) @map("puede_recoger")
  creadoEn             DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)

  tutor  Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  alumno Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@unique([tutorId, alumnoId])
  @@index([tenantId])
  @@index([alumnoId, esPagador])
  @@map("tutor_alumno")
  @@schema("public")
}

/// Aviso de privacidad de la escuela, VERSIONADO.
///
/// Versionado y no editable (LFPDPPP 2025): hay que poder demostrar que texto
/// exacto acepto cada tutor y cuando. Editar el aviso vigente borraria la
/// prueba de los consentimientos ya otorgados.
model AvisoPrivacidad {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  version     Int
  contenido   String
  publicadoEn DateTime  @default(now()) @map("publicado_en") @db.Timestamptz(6)
  vigenteAl   DateTime? @map("vigente_al") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  consentimientos Consentimiento[]

  @@unique([tenantId, version])
  @@map("aviso_privacidad")
  @@schema("public")
}

/// Consentimiento de un tutor para UNA finalidad concreta.
///
/// Por finalidad separada (§10): la ley de 2025 elimino la excepcion de "fines
/// compatibles". Las finalidades voluntarias (comunidad, gamificacion,
/// imagenes) deben poder rechazarse SIN perder el servicio educativo, y eso
/// solo es posible si cada una es una fila con su propia evidencia.
model Consentimiento {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @map("tenant_id") @db.Uuid
  avisoId    String              @map("aviso_id") @db.Uuid
  tutorId    String              @map("tutor_id") @db.Uuid
  /// Null = consentimiento general del tutor; con valor = referido a un alumno.
  alumnoId   String?             @map("alumno_id") @db.Uuid
  finalidad  Finalidad
  otorgado   Boolean
  /// Evidencia del acto (§10): por donde y cuando se manifesto. Sin esto, el
  /// consentimiento es una casilla sin valor probatorio.
  canal      CanalConsentimiento
  otorgadoEn DateTime            @default(now()) @map("otorgado_en") @db.Timestamptz(6)
  /// Revocacion: no se borra la fila, se marca. El historico es la prueba.
  revocadoEn DateTime?           @map("revocado_en") @db.Timestamptz(6)

  aviso AvisoPrivacidad @relation(fields: [avisoId], references: [id])
  tutor Tutor           @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tenantId, finalidad])
  @@index([tutorId, finalidad])
  @@map("consentimiento")
  @@schema("public")
}

/// Bitacora de auditoria de la escuela. Append-only (§12).
///
/// Es a la vez el registro legal de quien hizo que y la tabla de hechos de la
/// operacion: por eso lleva las cuatro coordenadas de §37 en columnas tipadas,
/// no enterradas en un JSON.
model EventoAuditoria {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Quien. Null solo para procesos del sistema (crons), nunca para acciones
  /// de una persona.
  actorId    String?  @map("actor_id") @db.Uuid
  tipo       String
  entidad    String
  entidadId  String?  @map("entidad_id") @db.Uuid
  ocurridoEn DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(6)
  datos      Json?

  @@index([tenantId, ocurridoEn])
  @@index([tenantId, entidad, entidadId])
  @@map("evento_auditoria")
  @@schema("public")
}

/// Parametros de operacion de UNA escuela. 1:1 con Tenant.
///
/// Tabla aparte y no columnas en `tenant` porque el tenant es la raiz de
/// identidad y aislamiento; mezclarle preferencias operativas hace que cada
/// ajuste de producto toque la tabla mas critica del sistema.
model ConfiguracionEscuela {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @unique @map("tenant_id") @db.Uuid

  /// Faltas dentro de la ventana que disparan el aviso acumulado. Es
  /// configurable porque la tolerancia real difiere por vertical: tres faltas
  /// en un colegio son una alerta; en una academia deportiva de fin de semana
  /// pueden ser un mes entero.
  umbralFaltas      Int     @default(3) @map("umbral_faltas")
  ventanaDias       Int     @default(30) @map("ventana_dias")
  /// Si se avisa la falta del dia ademas del acumulado. Una escuela puede
  /// preferir solo el acumulado para no saturar a las familias.
  avisarFaltaDelDia Boolean @default(true) @map("avisar_falta_del_dia")

  /// Zona horaria de la escuela. Mexico tiene varias (Baja California, Sonora,
  /// Quintana Roo): calcular "hoy" en UTC marcaria faltas del dia equivocado
  /// en las escuelas del noroeste, y el servidor no siempre corre en Mexico.
  zonaHoraria String @default("America/Mexico_City") @map("zona_horaria")

  /// --- Cobranza (S4) ---
  /// Dia del mes en que vencen los cargos, salvo que el concepto diga otro.
  diaVencimientoPorOmision Int     @default(5) @map("dia_vencimiento_por_omision")
  /// Dias que la escuela acepta sin recargo. El dominio NUNCA baja del piso
  /// legal de 10 dias naturales (Art. 4 del Acuerdo DOF 10-mar-1992) aunque
  /// aqui se configure menos: la escuela puede ser mas generosa, no mas
  /// estricta. Por eso la regla vive en el codigo y esta columna solo puede
  /// ampliarla.
  diasGraciaSinRecargo     Int     @default(10) @map("dias_gracia_sin_recargo")
  /// Recargo por mora, en porcentaje sobre el importe. Decimal, no float (§4).
  recargoPorcentaje        Decimal @default(0) @map("recargo_porcentaje") @db.Decimal(5, 2)

  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("configuracion_escuela")
  @@schema("public")
}

/// Quien puede pasar lista de una cohorte.
///
/// Tabla y no columna `responsableId` en Cohorte: existe la co-docencia (dos
/// maestras de un mismo grupo) y las academias con entrenador y auxiliar. Una
/// columna obligaria a elegir a uno y dejar al otro fuera del sistema.
model AsignacionDocente {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  cohorteId String   @map("cohorte_id") @db.Uuid
  /// Titular del grupo. El auxiliar tambien pasa lista, pero los reportes de
  /// dirección se dirigen al titular.
  titular   Boolean  @default(true)
  creadaEn  DateTime @default(now()) @map("creada_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cohorte Cohorte @relation(fields: [cohorteId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, cohorteId])
  @@index([tenantId])
  @@index([cohorteId])
  @@map("asignacion_docente")
  @@schema("public")
}

/// Asistencia de UN alumno, en UNA cohorte, en UN dia (AZ-M3.1).
///
/// HECHO CORREGIBLE, no evento inmutable (§39). El docente se equivoca y la
/// justificacion llega dos dias despues: un modelo de solo-agregar obligaria a
/// leer N eventos para responder "¿falto Sofia el martes?". La fila se corrige
/// y CADA correccion deja rastro en `evento_auditoria`, que si es append-only.
/// Asi la consulta es barata y la historia sigue siendo indestructible.
///
/// Unicidad por (alumno, cohorte, fecha) y no por (alumno, fecha): un alumno
/// puede estar inscrito en un grado Y en un taller vespertino, y cada grupo
/// pasa su lista.
model Asistencia {
  id        String           @id @default(uuid()) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  alumnoId  String           @map("alumno_id") @db.Uuid
  cohorteId String           @map("cohorte_id") @db.Uuid
  /// Fecha escolar, no instante. `date` y no `timestamptz`: "el martes" es el
  /// martes en la escuela, sin importar en que zona corre el servidor.
  fecha     DateTime         @db.Date
  estado    EstadoAsistencia
  nota      String?

  /// Quien registro el ultimo estado, y cuando. Coordenadas §37 en columnas.
  registradoPor String   @map("registrado_por") @db.Uuid
  registradoEn  DateTime @default(now()) @map("registrado_en") @db.Timestamptz(6)

  alumno  Alumno  @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  cohorte Cohorte @relation(fields: [cohorteId], references: [id], onDelete: Cascade)

  @@unique([alumnoId, cohorteId, fecha])
  @@index([tenantId, fecha])
  @@index([tenantId, cohorteId, fecha])
  @@index([tenantId, alumnoId, fecha])
  @@map("asistencia")
  @@schema("public")
}

/// Aviso dirigido a UNA persona. Es a la vez outbox de envio y registro de lo
/// comunicado (AZ-M5.1/AZ-M5.2).
///
/// La fila se crea DENTRO de la transaccion que produce el hecho, y el envio
/// ocurre despues del commit (ADR-010). Si el proceso muere entre ambos, el
/// aviso queda pendiente y reenviable — nunca se pierde ni se duplica, porque
/// `clave` es unica por escuela.
model Notificacion {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  /// Destinatario. Persona, no dispositivo: una madre puede tener dos telefonos
  /// y el aviso es uno solo.
  usuarioId String @map("usuario_id") @db.Uuid

  /// Tipo estable para analitica (§37). Cambiar estas cadenas rompe series
  /// historicas: se agregan tipos, no se renombran.
  tipo     String
  titulo   String
  cuerpo   String
  /// A donde lleva el toque. Sin destino la notificacion informa pero no
  /// resuelve — el reclamo mas repetido del corpus de resenas del sector.
  destino  String?
  /// Alumno al que se refiere, cuando aplica. Columna y no JSON: se agrupa por
  /// alumno en los reportes.
  alumnoId String? @map("alumno_id") @db.Uuid

  /// Clave de idempotencia (§15): `falta:{alumno}:{fecha}`,
  /// `acumulada:{alumno}:{ano-mes}`. Unica POR DESTINATARIO: el mismo aviso
  /// llega a la madre y al padre (dos filas), pero jamas dos veces a la misma
  /// persona. La unicidad la impone la BASE, no la aplicacion: dos peticiones
  /// concurrentes no pueden ganar las dos.
  clave String

  creadaEn     DateTime  @default(now()) @map("creada_en") @db.Timestamptz(6)
  enviadaEn    DateTime? @map("enviada_en") @db.Timestamptz(6)
  /// Cuantos dispositivos alcanzo. 0 con `enviadaEn` puesto significa que la
  /// familia no tiene la app instalada: dato de producto, no error.
  dispositivos Int       @default(0)
  leidaEn      DateTime? @map("leida_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([tenantId, usuarioId, clave])
  @@index([tenantId, usuarioId, creadaEn])
  @@index([tenantId, tipo, creadaEn])
  @@map("notificacion")
  @@schema("public")
}

/// Estados del pase de lista.
///
/// RETARDO existe separado de AUSENTE porque no es lo mismo para la familia ni
/// para el indicador de riesgo: un retardo NO dispara aviso (§40). JUSTIFICADA
/// es una falta con causa reconocida por la escuela — cuenta en el expediente,
/// no en el disparador de alerta.
enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  RETARDO
  JUSTIFICADA

  @@schema("public")
}

/// EL CATALOGO: que cobra la escuela (AZ-M4.1). Pantalla 8 de la matriz D10.
///
/// Un concepto es "colegiatura de primaria", "inscripcion", "comedor". Su
/// precio se CONGELA en cada cargo generado: cambiar el monto aqui no reescribe
/// la historia, porque un recibo emitido no puede cambiar de importe despues.
model ConceptoCargo {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  /// Clave estable para analitica (§37): se agregan, no se renombran. Es lo que
  /// permite comparar "colegiatura" entre escuelas y entre ciclos.
  clave        String
  nombre       String
  periodicidad Periodicidad
  montoBase    Decimal      @map("monto_base") @db.Decimal(10, 2)

  /// Dia del mes en que vence. El piso de diez dias naturales sin recargo NO
  /// se configura aqui: lo impone el dominio (Art. 4).
  diaVencimiento Int @default(5) @map("dia_vencimiento")

  /// Alcance. Null = toda la escuela; con valor = solo esa cohorte. Asi una
  /// primaria y una secundaria en el mismo tenant cobran distinto sin duplicar
  /// el catalogo entero.
  cohorteId String? @map("cohorte_id") @db.Uuid

  /// --- Datos fiscales (complemento IEDU) ---
  /// Se capturan AHORA aunque la facturacion llegue en R2: el complemento exige
  /// nivel educativo y RVOE, y pedirlos despues obligaria a recapturar escuela
  /// por escuela (principio 4, captura unica).
  deducibleIedu  Boolean         @default(false) @map("deducible_iedu")
  nivelEducativo NivelEducativo? @map("nivel_educativo")

  /// --- Articulo 7: que cuenta como COLEGIATURA (§52) ---
  /// El Acuerdo permite suspender el servicio tras tres COLEGIATURAS impagas,
  /// no tras tres adeudos. Un comedor y una excursion sin pagar no acercan a la
  /// familia a la suspension, por mas que sumen dinero.
  ///
  /// POR QUE NO SE DEDUCE DE `periodicidad`: el comedor tambien es MENSUAL. La
  /// colegiatura es el pago por el SERVICIO EDUCATIVO, y eso solo lo sabe la
  /// escuela. Nace en `false` porque contar de menos hace que la escuela no
  /// pueda suspender cuando podria —dinero—, y contar de mas la haria suspender
  /// cuando la ley aun no se lo permite —multa—. Ante la duda, el lado seguro.
  esColegiatura Boolean @default(false) @map("es_colegiatura")

  /// --- Saldo a favor (AZ-M4.10) ---
  /// Si un cargo de este concepto puede saldarse solo con el dinero que la
  /// familia ya tiene a favor. Casi siempre si; la excepcion son los conceptos
  /// que la escuela cobra por cuenta de un tercero (una excursion que se le
  /// paga al operador, un examen externo), donde consumir el saldo a favor sin
  /// que nadie lo decida deja a la familia sin ese dinero para la colegiatura.
  aceptaSaldoAFavor Boolean @default(true) @map("acepta_saldo_a_favor")

  /// --- Articulo 5, fraccion I: aviso de ajuste de cuotas ---
  /// Cuando entra en vigor este precio y cuando se le aviso a las familias.
  /// Sin las dos fechas no se puede demostrar los 60 dias de anticipacion.
  vigenteDesde DateTime  @map("vigente_desde") @db.Date
  avisadoEn    DateTime? @map("avisado_en") @db.Date

  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn DateTime @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cohorte Cohorte? @relation(fields: [cohorteId], references: [id], onDelete: Cascade)
  cargos  Cargo[]

  @@unique([tenantId, clave])
  @@index([tenantId, activo])
  @@map("concepto_cargo")
  @@schema("public")
}

/// LO QUE UN ALUMNO DEBE en un periodo (AZ-M4.2).
///
/// Hecho con importe congelado: `monto`, `fechaVencimiento` y
/// `fechaLimiteSinRecargo` se calculan al generar y NO se recalculan al leer.
/// Si manana la escuela sube la colegiatura o cambia su dia de vencimiento, los
/// cargos ya emitidos no se mueven — que es justo lo que exige poder demostrar
/// que se cobro lo que se anuncio.
model Cargo {
  id         String @id @default(uuid()) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  alumnoId   String @map("alumno_id") @db.Uuid
  conceptoId String @map("concepto_id") @db.Uuid

  /// Periodo de cobro en formato AAAA-MM. Columna tipada y estable, no un
  /// rango de fechas que haya que interpretar en cada consulta (§37).
  periodo String  @db.VarChar(7)
  monto   Decimal @db.Decimal(10, 2)

  fechaVencimiento      DateTime @map("fecha_vencimiento") @db.Date
  /// Ultimo dia en que se acepta el pago SIN recargo (Art. 4). Se congela con
  /// el cargo: la prueba de que la escuela respeto la ventana es esta columna,
  /// no la configuracion vigente meses despues.
  fechaLimiteSinRecargo DateTime @map("fecha_limite_sin_recargo") @db.Date

  /// Ciclo de vida del cargo: VIGENTE o CANCELADO. **`PAGADO` no se escribe**:
  /// si algo esta pagado se deriva de la suma de sus aplicaciones de pago, no
  /// de una columna que habria que mantener sincronizada. El dia que esa
  /// columna y la suma difieran, nadie sabria cual de las dos creer. El valor
  /// se conserva en el enum por compatibilidad con los datos ya escritos.
  estado EstadoCargo @default(PENDIENTE)

  /// Clave de idempotencia (§15): {alumno}:{concepto}:{periodo}. La unicidad la
  /// impone la base, no la aplicacion: dos administradores generando a la vez
  /// no pueden duplicar un cargo.
  clave String

  generadoEn        DateTime  @default(now()) @map("generado_en") @db.Timestamptz(6)
  /// Quien lo genero. Null solo para procesos del sistema (§37).
  generadoPor       String?   @map("generado_por") @db.Uuid
  canceladoEn       DateTime? @map("cancelado_en") @db.Timestamptz(6)
  /// Cancelar exige decir por que. Un cargo que desaparece sin motivo es un
  /// agujero en la contabilidad de la escuela.
  motivoCancelacion String?   @map("motivo_cancelacion")

  alumno   Alumno         @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  concepto ConceptoCargo  @relation(fields: [conceptoId], references: [id])
  partes   ParteDeCargo[]

  @@unique([tenantId, clave])
  @@index([tenantId, periodo])
  @@index([tenantId, alumnoId, periodo])
  @@index([tenantId, estado, fechaVencimiento])
  @@map("cargo")
  @@schema("public")
}

/// A QUIEN le toca cuanto de un cargo (AZ-M4.3).
///
/// El reparto se CONGELA al generar y no se recalcula. Si un convenio cambia el
/// 60/40 a 50/50 en marzo, los cargos de enero y febrero siguen repartidos como
/// estaban: lo contrario reescribiria retroactivamente lo que cada quien debia.
///
/// La suma de las partes es EXACTAMENTE el monto del cargo — invariante
/// probada en el modulo puro, no confiada al redondeo de la base de datos.
model ParteDeCargo {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  cargoId  String @map("cargo_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  porcentaje Decimal @db.Decimal(5, 2)
  monto      Decimal @db.Decimal(10, 2)

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  cargo        Cargo              @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  tutor        Tutor              @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  aplicaciones AplicacionDePago[]

  @@unique([cargoId, tutorId])
  @@index([tenantId, tutorId])
  @@map("parte_de_cargo")
  @@schema("public")
}

enum Periodicidad {
  /// Se genera cada mes: la colegiatura.
  MENSUAL
  /// Una sola vez: inscripcion, examen extraordinario, credencial.
  UNICO
  /// Una vez por ciclo.
  ANUAL

  @@schema("public")
}

enum EstadoCargo {
  PENDIENTE
  PAGADO
  CANCELADO

  @@schema("public")
}

/// Niveles del complemento IEDU del SAT. Los valores son los que exige el
/// complemento; inventar otros haria que el CFDI se rechace al timbrar.
enum NivelEducativo {
  PREESCOLAR
  PRIMARIA
  SECUNDARIA
  PROFESIONAL_TECNICO
  BACHILLERATO

  @@schema("public")
}

/// UN PAGO RECIBIDO (AZ-M4.9). Es un asiento, no una edicion del cargo.
///
/// El cargo NUNCA cambia de importe cuando alguien paga: se registra el pago y
/// se aplica. El saldo se deriva de restar lo aplicado. Lo contrario —tocar el
/// importe del cargo— destruiria la prueba de que se cobro lo que se anuncio,
/// que es justo lo que el Acuerdo de PROFECO exige poder sostener.
///
/// Por que el pagador es un Tutor y no un "alumno" o una "familia": porque el
/// reparto del Sprint 4 asigna partes a tutores concretos. Cuando el padre paga
/// su 40%, se sabe exactamente que se salda.
model Pago {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tutorId  String @map("tutor_id") @db.Uuid

  monto      Decimal    @db.Decimal(10, 2)
  fecha      DateTime   @db.Date
  metodo     MetodoPago
  /// Folio de la transferencia, del deposito o del recibo de caja. Es lo que
  /// permite conciliar contra el estado de cuenta del banco.
  referencia String?
  nota       String?

  registradoPor String?  @map("registrado_por") @db.Uuid
  registradoEn  DateTime @default(now()) @map("registrado_en") @db.Timestamptz(6)

  /// Cancelar un pago NO lo borra: un pago que desaparece de la historia es un
  /// agujero en la caja de la escuela.
  canceladoEn       DateTime? @map("cancelado_en") @db.Timestamptz(6)
  motivoCancelacion String?   @map("motivo_cancelacion")

  tutor        Tutor              @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  aplicaciones AplicacionDePago[]

  @@index([tenantId, fecha])
  @@index([tenantId, tutorId])
  @@map("pago")
  @@schema("public")
}

/// A QUE se aplico un pago. La costura entre lo que entro y lo que se debia.
///
/// Un pago puede saldar varias partes (una transferencia que cubre colegiatura
/// y comedor) y una parte puede recibir varios pagos (dos abonos parciales).
/// Por eso es una tabla y no una columna.
///
/// INVARIANTES, probadas y no confiadas al cuidado de quien escribe:
///   - la suma aplicada de un pago nunca excede su importe;
///   - la suma aplicada a una parte nunca excede lo que esa parte debe.
model AplicacionDePago {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  pagoId         String @map("pago_id") @db.Uuid
  parteDeCargoId String @map("parte_de_cargo_id") @db.Uuid

  monto    Decimal  @db.Decimal(10, 2)
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(6)

  pago  Pago         @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  parte ParteDeCargo @relation(fields: [parteDeCargoId], references: [id], onDelete: Cascade)

  @@unique([pagoId, parteDeCargoId])
  @@index([tenantId, parteDeCargoId])
  @@map("aplicacion_de_pago")
  @@schema("public")
}

/// Como llego el dinero. Importa para conciliar: una transferencia se busca por
/// folio en el banco; el efectivo, en el corte de caja.
enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  DEPOSITO
  TARJETA
  OTRO

  @@schema("public")
}

enum Vertical {
  COLEGIO
  UNIVERSIDAD
  ACADEMIA_DEPORTIVA
  ESCUELA_IDIOMAS
  TALLER

  @@schema("public")
}

enum Rol {
  DUENO
  DIRECTOR
  ADMIN
  COBRANZA
  DOCENTE
  STAFF
  /// Madre, padre o tutor con acceso a la app. Es un rol como los demas y no
  /// un tipo de cuenta aparte: la misma persona puede ser tutora de su hijo Y
  /// docente en la escuela, y entra una sola vez.
  TUTOR

  @@schema("public")
}

/// Dispositivo donde una persona recibe notificaciones (AZ-M5.3, cimiento).
///
/// Es una tabla y no una columna en Usuario porque una familia real usa varios
/// telefonos: la madre en el suyo, el padre en el suyo. Notificar "al usuario"
/// y no "a sus dispositivos" dejaria a uno de los dos sin enterarse.
model DispositivoPush {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  usuarioId  String     @map("usuario_id") @db.Uuid
  /// Token que emite el servicio de notificaciones para ESTE dispositivo.
  /// Cambia cuando el sistema operativo lo rota; por eso se re-registra en
  /// cada arranque en lugar de guardarse una sola vez.
  token      String     @unique
  plataforma Plataforma
  /// Ultima vez que el dispositivo se reporto vivo. Sirve para dejar de
  /// enviar a telefonos que ya no existen (los tokens muertos degradan la
  /// reputacion del canal).
  vistoEn    DateTime   @default(now()) @map("visto_en") @db.Timestamptz(6)
  creadoEn   DateTime   @default(now()) @map("creado_en") @db.Timestamptz(6)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([usuarioId])
  @@map("dispositivo_push")
  @@schema("public")
}

enum Plataforma {
  IOS
  ANDROID
  WEB

  @@schema("public")
}

enum TipoPeriodo {
  CICLO_ESCOLAR
  TEMPORADA
  CONTINUO

  @@schema("public")
}

enum TipoCohorte {
  GRADO
  CATEGORIA
  NIVEL
  TALLER

  @@schema("public")
}

enum EstadoInscripcion {
  ACTIVA
  BAJA
  EGRESADO

  @@schema("public")
}

enum Parentesco {
  MADRE
  PADRE
  TUTOR
  ABUELO
  OTRO

  @@schema("public")
}

/// Finalidades del tratamiento. Las NECESARIAS sostienen el servicio
/// contratado; las VOLUNTARIAS deben poder rechazarse sin perderlo (§10).
enum Finalidad {
  // Necesarias
  GESTION_ESCOLAR
  COBRANZA
  COMUNICACION_OPERATIVA
  // Voluntarias
  EXPEDIENTE_SALUD
  IMAGENES
  COMUNIDAD
  COMUNICACION_COMERCIAL

  @@schema("public")
}

enum CanalConsentimiento {
  APP
  WEB
  PAPEL
  IMPORTACION

  @@schema("public")
}

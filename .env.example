# =============================================================================
# Azahar — plantilla de entorno. Copiar a .env y ajustar.
# Regla §: ningun secreto real vive en el repo. Este archivo documenta QUE se
# necesita y POR QUE, nunca valores de produccion.
# =============================================================================

# --- Base de datos ------------------------------------------------------------
# DATABASE_URL: la usa la APLICACION. Apunta al rol restringido azahar_app
# (NOSUPERUSER, NOBYPASSRLS). Si la app se conectara con el owner, RLS quedaria
# desactivado en silencio y el test de aislamiento daria un falso verde
# (defecto real documentado en Zentor: el owner de la nube tiene BYPASSRLS).
DATABASE_URL="postgresql://azahar_app:azahar_app_pw@localhost:5434/azahar?schema=public"

# DATABASE_URL_OWNER: SOLO para migraciones y para crear el rol de aplicacion.
# Nunca se usa en runtime ni en pruebas.
DATABASE_URL_OWNER="postgresql://azahar_owner:azahar_dev_pw@localhost:5434/azahar?schema=public"

# --- API ----------------------------------------------------------------------
API_PORT=3333
# Secreto de firma de sesion. En produccion: valor aleatorio de >=32 bytes,
# inyectado por el proveedor, jamas en el repo.
AUTH_SECRET="cambiar-en-produccion-min-32-caracteres-aleatorios"

# --- Web ----------------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:3333"

# --- Integraciones externas (patron adaptador, §18) ---------------------------
# Todas nacen en "simulated": desarrollo y pruebas corren sin credenciales ni
# costo. El proveedor real se activa por variable, y antes de produccion se
# ejecuta un smoke real (lo simulado engana si nunca se prueba el efecto).
EMISOR_FISCAL_PROVIDER=simulated   # simulated | facturama   (ADR-002, POC en S5)
PROCESADOR_PAGOS_PROVIDER=simulated # simulated | stripe | conekta | openpay (ADR-007, S5)
MENSAJERIA_PROVIDER=simulated      # simulated | whatsapp_cloud | ses  (S7)

# Origen de la web. La API solo acepta peticiones con credenciales desde aqui.
# 3010 y no 3000: la maquina ya corre otros proyectos en los puertos comunes.
NEXT_PUBLIC_WEB_ORIGIN="http://localhost:3010"
